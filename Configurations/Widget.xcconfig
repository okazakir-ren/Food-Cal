#include "Shared.xcconfig"
PRODUCT_NAME = AruiteGohanWidget
PRODUCT_BUNDLE_IDENTIFIER = jp.renokazaki.aruitegohan.widget
CODE_SIGN_ENTITLEMENTS = Configurations/Widget.entitlements
INFOPLIST_FILE = Configurations/Widget-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = あるいてごはん
APPLICATION_EXTENSION_API_ONLY = YES
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
