#include "Shared.xcconfig"
PRODUCT_NAME = AruiteGohanWatch
PRODUCT_BUNDLE_IDENTIFIER = jp.renokazaki.aruitegohan.watchkitapp
SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
WATCHOS_DEPLOYMENT_TARGET = 26.0
CODE_SIGN_ENTITLEMENTS = Configurations/Watch.entitlements
INFOPLIST_FILE = Configurations/Watch-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = あるいてごはん
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = jp.renokazaki.aruitegohan
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
